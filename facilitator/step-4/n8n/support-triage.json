{
  "id": "d851075c-6f45-4ec0-9d0e-f6ac499b3ce2",
  "name": "Support Triage",
  "nodes": [
    {
      "id": "83c3c037-b220-4d50-8d5b-5d66d4621bc4",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [180, 120],
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "options": {
          "responseMode": "lastNode"
        }
      }
    },
    {
      "id": "a3f97dd2-d74e-4b93-9b44-e6dc6a0c8393",
      "name": "When clicking ‘Execute workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [180, 360],
      "parameters": {}
    },
    {
      "id": "829f42d9-bcbb-4978-b86c-e977591d136c",
      "name": "Ticket Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [390, 360],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"customer_id\": \"CUST-003\",\n  \"message\": \"I was charged twice for transaction TX-1003. Please help me understand what happened.\"\n}",
        "options": {}
      }
    },
    {
      "id": "edab7bb5-788f-4d35-a947-4d7d6cb62291",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [650, 220],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.customer_id ? 'Customer: ' + $json.customer_id + '\\nMessage: ' + $json.message : $json.chatInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the main support automation coordinator. For a CUST-### ID, ask Customer Context Agent for customer context. Ask Risk Agent to classify the ticket and assess risk using that context. Ask Customer Reply Agent to draft a reply using the original message and specialist results. Do not invent facts. Return the required structured fields."
        }
      }
    },
    {
      "id": "ee2f0055-611a-4b34-b938-85b2880c45b5",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [500, 520],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      }
    },
    {
      "id": "1f98aef8-8f83-4c5e-a399-e2c31e93f191",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [650, 520],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.sessionId || 'manual-session' }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "4f5db3da-1b92-430c-acfb-bd57e1189444",
      "name": "Priority Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [820, 520],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"priority\": { \"type\": \"string\", \"enum\": [\"low\", \"medium\", \"high\"] },\n    \"sentiment\": { \"type\": \"string\", \"enum\": [\"neutral\", \"frustrated\", \"angry\"] },\n    \"recommended_action\": { \"type\": \"string\", \"enum\": [\"auto_reply\", \"investigate\", \"escalate\"] },\n    \"summary\": { \"type\": \"string\" },\n    \"risk_note\": { \"type\": \"string\" },\n    \"customer_reply\": { \"type\": \"string\" }\n  },\n  \"required\": [\"priority\", \"sentiment\", \"recommended_action\", \"summary\", \"risk_note\", \"customer_reply\"],\n  \"additionalProperties\": false\n}"
      }
    },
    {
      "id": "2bc51e34-af55-4dd2-a19e-f5cc2567a53a",
      "name": "Customer Reply Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [360, 700],
      "parameters": {
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are a customer support communication specialist. Write a short, friendly and professional reply using the ticket context and the risk-agent result. Do not change or re-decide priority. Do not mention internal risk notes or priority. Do not promise refunds, compensation or timelines, and do not invent facts."
        }
      }
    },
    {
      "id": "809612d1-c8b2-43df-95f5-d6308a971a66",
      "name": "Risk Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [610, 700],
      "parameters": {
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are a payment risk and escalation specialist. Review the ticket context and identify customer risk, complaint risk, urgency, and whether escalation is needed. Judge impact and risk, not tone. Return priority (low, medium or high) and a short internal risk note."
        }
      }
    },
    {
      "id": "0af16fd7-37bc-4f33-b217-898296b5c813",
      "name": "Customer Context Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [870, 700],
      "parameters": {
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are the customer context specialist. Use the Get row(s) in Data table tool to look up a CUST-### ID. Report the customer's type, transaction volume, previous incidents, and whether they are critical. If no record is found, say so and do not guess. Do not classify priority or write to the customer."
        }
      }
    },
    {
      "id": "05c20378-93c0-4f48-9d20-dbb10d194eaf",
      "name": "Get row(s) in Data table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1130, 700],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "customer_context"
        },
        "returnAll": false,
        "filters": {
          "conditions": [
            {
              "keyName": "customer_id",
              "keyValue": "={{ $fromAI('customer_id', 'Customer ID in CUST-### format', 'string') }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "43f85e07-2300-4f5f-b0ec-89c81574365c",
      "name": "Reply Agent Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [360, 880],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {}
      }
    },
    {
