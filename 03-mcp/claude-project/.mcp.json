{
  "mcpServers": {
    "transactions": {
      "type": "stdio",
      "command": "node",
      "args": ["../transaction-mcp/server.js"],
      "env": {
        "TRANSACTIONS_WRITES_ENABLED": "1"
      }
    },
    "customers": {
      "type": "stdio",
      "command": "node",
      "args": ["../transaction-mcp/customers.js"]
    },
    "drafts": {
      "type": "stdio",
      "command": "node",
      "args": ["../transaction-mcp/drafts-server.js"]
    }
  }
}
